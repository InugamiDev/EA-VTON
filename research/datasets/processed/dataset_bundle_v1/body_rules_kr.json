{
  "_doc": "Upper-body styling rules per Korean-female body cluster. Polarity ∈ {+1, 0, -1} for recommend/neutral/avoid. Cluster definitions are from Lee et al. 2007 (KR sample) + Size Korea 8th KATS 2020. Polarity assignments follow the body-clothing fit methodology of Hidayati et al. MM 2018. Rules are CC BY 4.0.",
  "_source_clusters": {
    "citation": "Lee, J.Y., Istook, C.L., Nam, Y.J., Park, S.M. (2007). 'Comparison of body shape between USA and Korean women', IJCST 19(5).",
    "supplemented_with": "Size Korea (KATS) 8th anthropometric survey, 2020.",
    "method": "FFIT female figure identification on Korean Size Korea sample (n=259).",
    "url": "https://sizekorea.kr/page/about/1",
    "anthropometric_profile_summary": "Korean adult women (2020): mean height 158.4 cm, mean weight 56.9 kg, waist-hip ratio 0.80 (vs US WHR 0.83)."
  },
  "_source_polarities": {
    "citation": "Hidayati et al. (2018). 'What Dress Fits Me Best?', ACM MM 2018.",
    "doi": "10.1145/3240508.3240546",
    "method": "Per-body-type attribute polarity encoding as in Hidayati 2018; specific KR-cluster values are this paper's derivation calibrated against the Lee 2007 FFIT-KR cluster descriptions.",
    "url": "https://dl.acm.org/doi/10.1145/3240508.3240546"
  },
